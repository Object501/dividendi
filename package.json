{
	"name": "dividendi",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
		"dev": "vite --config frontend/vite.config.ts",
		"preview": "vite preview --config frontend/vite.config.ts",
		"test": "vitest run --config frontend/vite.config.ts",
		"typecheck": "tsc -b frontend/tsconfig.json"
	},
	"dependencies": {
		"echarts": "6.1.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@types/node": "26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.1",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	}
}
