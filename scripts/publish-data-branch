#!/usr/bin/env bash

set -euo pipefail

if (( $# < 1 || $# > 2 )); then
	echo "usage: scripts/publish-data-branch DATA_DIRECTORY [REMOTE]" >&2
	exit 2
fi

data_directory=$1
remote=${2:-origin}

if [[ ! -f "$data_directory/history.json" ]]; then
	echo "missing data file: $data_directory/history.json" >&2
	exit 2
fi

git_directory=$(git rev-parse --absolute-git-dir)
data_directory=$(cd "$data_directory" && pwd)
script_directory=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
expected_commit=$(git ls-remote --heads "$remote" refs/heads/data | cut -f1)
temporary_directory=$(mktemp -d)
trap 'rm -rf -- "$temporary_directory"' EXIT

export GIT_DIR=$git_directory
export GIT_INDEX_FILE=$temporary_directory/index
export GIT_WORK_TREE=$data_directory

if [[ -z "$expected_commit" ]] \
	|| ! git cat-file -e "$expected_commit:history.json" 2>/dev/null \
	|| ! cmp -s <(git show "$expected_commit:history.json") "$data_directory/history.json"; then
	changed=true
	else
	changed=false
fi

if [[ $changed == false ]]; then
	printf 'data unchanged\n'
	exit 0
fi

git read-tree --empty
git add -- history.json
tree=$(git write-tree)
commit=$(bash "$script_directory/data-commit-message" history.json | git commit-tree "$tree")

git push \
	"$remote" \
	"$commit:refs/heads/data" \
	"--force-with-lease=refs/heads/data:$expected_commit"

printf '%s\n' "$commit"
